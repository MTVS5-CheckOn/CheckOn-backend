KAFKA_BOOTSTRAP_SERVERS=
AI_PROBLEM_KAFKA_ENABLED=
AI_PROBLEM_REQUEST_TOPIC=
AI_PROBLEM_RESULT_TOPIC=
AI_PROBLEM_DLT_TOPIC=

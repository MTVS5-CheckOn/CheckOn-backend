# Local Problem Studio E2E: Backend -> Kafka -> Adapter -> deployed AI
# These are Backend -> Adapter settings. The Adapter uses
# AI_PROBLEM_DIAGNOSIS_PATH=/v1/diagnosis for its separate Adapter -> AI call.
AI_PROBLEM_ADAPTER_BASE_URL=http://localhost:8081
AI_PROBLEM_DIAGNOSIS_PATH=/internal/v1/problem-diagnoses
AI_PROBLEM_DIAGNOSIS_READ_TIMEOUT=10s

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
CHECKON_APP_DB_USER=
CHECKON_APP_DB_PASSWORD=

CHECKON_JWT_SECRET=

# 브라우저 프론트엔드의 정확한 Origin 목록(쉼표 구분).
# 스킴·호스트·포트만 허용하며 와일드카드, 경로, 끝 슬래시는 거부된다.
# 로컬 예: http://localhost:3000,http://localhost:5173
# 배포 예: https://checkon-front.vercel.app
AUTH_ALLOWED_ORIGINS=

# Refresh 쿠키 배포 정책.
# - 로컬 HTTP(dev 프로필): Lax / false
# - 같은 사이트 HTTPS: Lax / true
# - 서로 다른 사이트 HTTPS: None / true
# SameSite=None과 Secure=false 조합은 애플리케이션 시작 단계에서 거부된다.
REFRESH_COOKIE_SAME_SITE=
REFRESH_COOKIE_SECURE=

                                                                                       "description":  "요청 값 오류"
                                                                                   },
                                                                           "401":  {
                                                                                       "$ref":  "#/components/responses/Unauthorized",
                                                                                       "description":  "인증 실패. Security filter가 생성하므로 JSON 오류 본문은 보장되지 않는다."
                                                                                   },
                                                                           "403":  {
                                                                                       "$ref":  "#/components/responses/Forbidden",
                                                                                       "description":  "TEACHER 권한이 아님. Security가 생성하므로 JSON 오류 본문은 보장되지 않는다."
                                                                                   },
                                                                           "404":  {
                                                                                       "$ref":  "#/components/responses/LearningRecordTargetNotFound",
                                                                                       "description":  "관리하지 않는 학생·반 또는 occurredAt 시점에 유효하지 않은 반 소속"

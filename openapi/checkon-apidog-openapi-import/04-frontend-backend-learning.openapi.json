    "paths":  {
                  "/learning-records":  {
                                            "post":  {
                                                         "summary":  "수동 학습 기록 등록",
                                                         "deprecated":  false,
                                                         "description":  "인증 강사가 현재 관리하는 학생의 원본 학습 기록을 등록한다. classGroupId가 있으면\noccurredAt 시점의 해당 반 소속도 확인한다. externalRecordRef는 nullable이며 멱등 키나\n유일 값으로 취급하지 않는다. teacherId와 sourceType은 요청에서 받지 않는다.\n",
                                                         "operationId":  "registerLearningRecord",
                                                         "tags":  [
                                                                      "Learning Records"
                                                                  ],
                                                         "parameters":  [

                                                                        ],
                                                         "requestBody":  {
                                                                             "content":  {
                                                                                             "application/json":  {
                                                                                                                      "schema":  {
                                                                                                                                     "$ref":  "#/components/schemas/LearningRecordRequest"
                                                                                                                                 },
                                                                                                                      "example":  {
                                                                                                                                      "studentId":  "0198c000-0000-7000-8000-000000000002",
                                                                                                                                      "classGroupId":  "0198c000-0000-7000-8000-000000000003",
                                                                                                                                      "recordType":  "SOLVE",
                                                                                                                                      "occurredAt":  "2026-08-03T01:00:00Z",
                                                                                                                                      "correct":  true,
                                                                                                                                      "durationSec":  120,
                                                                                                                                      "passageWordCount":  800,
                                                                                                                                      "areaTag":  "reading"
                                                                                                                                  }
                                                                                                                  }
                                                                                         },
                                                                             "required":  true
                                                                         },
                                                         "responses":  {
                                                                           "201":  {
                                                                                       "description":  "학습 기록 등록 성공",
                                                                                       "content":  {
                                                                                                       "application/json":  {
                                                                                                                                "schema":  {
                                                                                                                                               "$ref":  "#/components/schemas/LearningRecordResponse"
                                                                                                                                           }
                                                                                                                            }
                                                                                                   },
                                                                                       "headers":  {
                                                                                                       "Location":  {
                                                                                                                        "required":  false,
                                                                                                                        "description":  "생성된 학습 기록 경로",
                                                                                                                        "schema":  {
                                                                                                                                       "type":  "string",
                                                                                                                                       "format":  "uri-reference"
                                                                                                                                   }
                                                                                                                    }
                                                                                                   }
                                                                                   },
                                                                           "400":  {

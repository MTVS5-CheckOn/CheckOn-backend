{
    "openapi":  "3.0.1",
    "info":  {
                 "title":  "CheckOn - Frontend to Backend - Detection",
                 "description":  "통신 방향: Frontend -\u003e Backend\n범위: Detection\n원본 계약의 path, request, response 내용은 유지하고 통신 경계별로 분리했다.",
                 "version":  "1.0.0"
             },
    "servers":  [
                    {
                        "url":  "http://localhost:8080/api/v1",
                        "description":  "Local CheckOn backend API"
                    }
                ],
    "tags":  [
                 {
                     "name":  "Detection"
                 }
             ],
    "paths":  {
                  "/detection-runs":  {
                                          "post":  {
                                                       "summary":  "위험 탐지 실행 요청",
                                                       "deprecated":  false,
                                                       "description":  "인증 강사의 analysisDate 기준 56일 학습 Snapshot을 준비하고 Kafka 요청 Outbox를 저장한다.\n동일 분석일과 동일 Snapshot의 재요청은 기존 실행을 재사용한다. status가 REQUESTED이면\n202, 이미 종료된 실행을 재사용하면 200을 반환한다.\n",
                                                       "operationId":  "requestDetectionRun",
                                                       "tags":  [
                                                                    "Detection"
                                                                ],
                                                       "parameters":  [

                                                                      ],
                                                       "requestBody":  {
                                                                           "content":  {
                                                                                           "application/json":  {
                                                                                                                    "schema":  {
                                                                                                                                   "$ref":  "#/components/schemas/DetectionRunRequest"
                                                                                                                               }
                                                                                                                }
                                                                                       },
                                                                           "required":  true
                                                                       },
                                                       "responses":  {
                                                                         "200":  {
                                                                                     "description":  "이미 종료된 동일 실행 조회",
                                                                                     "content":  {
                                                                                                     "application/json":  {
                                                                                                                              "schema":  {
                                                                                                                                             "$ref":  "#/components/schemas/DetectionRunResponse"
                                                                                                                                         }
                                                                                                                          }
                                                                                                 },
                                                                                     "headers":  {

                                                                                                 }
                                                                                 },
                                                                         "202":  {
                                                                                     "description":  "비동기 위험 탐지 요청 접수",
                                                                                     "content":  {
                                                                                                     "application/json":  {
                                                                                                                              "schema":  {
                                                                                                                                             "$ref":  "#/components/schemas/DetectionRunResponse"
                                                                                                                                         }
                                                                                                                          }
                                                                                                 },
                                                                                     "headers":  {
                                                                                                     "Location":  {
                                                                                                                      "required":  false,
                                                                                                                      "description":  "실행 상태 조회 경로",
                                                                                                                      "schema":  {
                                                                                                                                     "type":  "string",
                                                                                                                                     "format":  "uri-reference"
                                                                                                                                 }
                                                                                                                  }
                                                                                                 }
                                                                                 },
                                                                         "400":  {
                                                                                     "$ref":  "#/components/responses/InvalidRequest"
                                                                                 },
                                                                         "401":  {
                                                                                     "$ref":  "#/components/responses/Unauthorized"
                                                                                 },
                                                                         "403":  {
                                                                                     "$ref":  "#/components/responses/Forbidden"
                                                                                 },
                                                                         "409":  {
                                                                                     "$ref":  "#/components/responses/DetectionConflict"
                                                                                 },
                                                                         "422":  {
                                                                                     "$ref":  "#/components/responses/NoLearningRecords"
                                                                                 },
                                                                         "502":  {
                                                                                     "$ref":  "#/components/responses/AiDetectionFailure"
                                                                                 }
                                                                     },
                                                       "security":  [
                                                                        {
                                                                            "bearerAuth":  [

                                                                                           ]
                                                                        }
                                                                    ]
                                                   }
                                      },
                  "/detection-runs/{runId}":  {
                                                  "get":  {
                                                              "summary":  "위험 탐지 실행 상태 조회",
                                                              "deprecated":  false,
                                                              "description":  "다른 강사의 실행은 존재 여부를 숨기기 위해 RUN_NOT_FOUND로 처리한다.",
                                                              "operationId":  "getDetectionRun",
                                                              "tags":  [
                                                                           "Detection"
                                                                       ],
                                                              "parameters":  [
                                                                                 {
                                                                                     "name":  "runId",
                                                                                     "in":  "path",
                                                                                     "description":  "",
                                                                                     "required":  true,
                                                                                     "schema":  {
                                                                                                    "type":  "string",
                                                                                                    "format":  "uuid"
                                                                                                }
                                                                                 }
                                                                             ],
                                                              "responses":  {
                                                                                "200":  {
                                                                                            "description":  "실행 상태 조회 성공",
                                                                                            "content":  {
                                                                                                            "application/json":  {
                                                                                                                                     "schema":  {
                                                                                                                                                    "$ref":  "#/components/schemas/DetectionRunStatusResponse"
                                                                                                                                                }
                                                                                                                                 }
                                                                                                        },
                                                                                            "headers":  {

                                                                                                        }
                                                                                        },
                                                                                "400":  {
                                                                                            "$ref":  "#/components/responses/InvalidRequest"
                                                                                        },
                                                                                "401":  {
                                                                                            "$ref":  "#/components/responses/Unauthorized"
                                                                                        },
                                                                                "403":  {
                                                                                            "$ref":  "#/components/responses/Forbidden"
                                                                                        },
                                                                                "404":  {
                                                                                            "$ref":  "#/components/responses/DetectionRunNotFound"
                                                                                        }
                                                                            },
                                                              "security":  [
                                                                               {
                                                                                   "bearerAuth":  [

                                                                                                  ]
                                                                               }
                                                                           ]
                                                          }
                                              }
              },
    "components":  {
                       "schemas":  {
                                       "DetectionRunRequest":  {
                                                                   "type":  "object",
                                                                   "required":  [
                                                                                    "analysisDate"
                                                                                ],
                                                                   "properties":  {
                                                                                      "analysisDate":  {
                                                                                                           "type":  "string",
                                                                                                           "format":  "date"
                                                                                                       }
                                                                                  }
                                                               },
                                       "DetectionRunResponse":  {
                                                                    "type":  "object",
                                                                    "required":  [
                                                                                     "runId",
                                                                                     "status",
                                                                                     "analysisDate",
                                                                                     "created",
                                                                                     "attemptNumber"
                                                                                 ],
                                                                    "properties":  {
                                                                                       "runId":  {
                                                                                                     "type":  "string",
                                                                                                     "format":  "uuid"
                                                                                                 },
                                                                                       "status":  {
                                                                                                      "$ref":  "#/components/schemas/DetectionRunStatus"
                                                                                                  },
                                                                                       "analysisDate":  {
                                                                                                            "type":  "string",
                                                                                                            "format":  "date"
                                                                                                        },
                                                                                       "created":  {
                                                                                                       "type":  "boolean",
                                                                                                       "description":  "새 실행을 생성했으면 true, 기존 실행을 재사용하면 false."
                                                                                                   },
                                                                                       "attemptNumber":  {
                                                                                                             "type":  "integer",
                                                                                                             "format":  "int32",
                                                                                                             "minimum":  1
                                                                                                         }
                                                                                   }
                                                                },
                                       "DetectionRunStatusResponse":  {
        "type": "object",
        "required": [
          "runId",
          "status",
          "analysisDate",
          "snapshotHash",
          "aiExecutionId",
          "attemptCount",
          "errorCode",
          "stats"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/DetectionRunStatus"
          },
          "analysisDate": {
            "type": "string",
            "format": "date"
          },
          "snapshotHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Backend가 저장한 canonical AI 요청 스냅숏 해시"
          },
          "aiExecutionId": {
            "type": "string",
            "nullable": true,
            "description": "성공한 AI 실행 원장 식별자. 실행 전 또는 실패 시 null"
          },
          "attemptCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "stats": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DetectionRunStats"
              }
            ],
            "nullable": true,
            "description": "성공 결과가 저장되기 전에는 null. rulesSkipped로 신호 0건과 규칙 실행 불가를 구분한다."
          }
        }
      },
                                       "DetectionRunStats":  {
        "type": "object",
        "required": [
          "studentsEvaluated",
          "signalsRaised",
          "excludedUnderTwoWeeks",
          "cappedOut",
          "rulesSkipped",
          "r1ThresholdPp",
          "r1ThresholdSource",
          "r1PoolN"
        ],
        "properties": {
          "studentsEvaluated": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "signalsRaised": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "excludedUnderTwoWeeks": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "cappedOut": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "rulesSkipped": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkippedDetectionRule"
            }
          },
          "r1ThresholdPp": {
            "type": "number",
            "nullable": true,
            "description": "R1 판정에 사용된 정확도 하락 임계값(퍼센트포인트). 기존 응답에는 없을 수 있다."
          },
          "r1ThresholdSource": {
            "type": "string",
            "nullable": true,
            "description": "R1 임계값 산출 방식. AI 진단 메타데이터를 그대로 반환한다."
          },
          "r1PoolN": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "nullable": true,
            "description": "R1 임계값 산출에 사용된 테넌트 풀 표본 수."
          }
        }
      },
                                       "SkippedDetectionRule":  {
        "type": "object",
        "required": [
          "ruleId",
          "reason",
          "students"
        ],
        "properties": {
          "ruleId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "students": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
                                       "DetectionRunStatus":  {
                                                                  "type":  "string",
                                                                  "enum":  [
                                                                               "PREPARED",
                                                                               "REQUESTED",
                                                                               "SUCCEEDED",
                                                                               "FAILED"
                                                                           ]
                                                              },
                                       "ErrorResponse":  {
                                                             "type":  "object",
                                                             "required":  [
                                                                              "code",
                                                                              "message"
                                                                          ],
                                                             "properties":  {
                                                                                "code":  {
                                                                                             "type":  "string"
                                                                                         },
                                                                                "message":  {
                                                                                                "type":  "string"
                                                                                            }
                                                                            }
                                                         }
                                   },
                       "responses":  {
                                         "InvalidRequest":  {
                                                                "description":  "요청 값 오류",
                                                                "content":  {
                                                                                "application/json":  {
                                                                                                         "schema":  {
                                                                                                                        "$ref":  "#/components/schemas/ErrorResponse"
                                                                                                                    }
                                                                                                     }
                                                                            }
                                                            },
                                         "Unauthorized":  {
                                                              "description":  "인증 실패. Security filter가 생성하므로 JSON 오류 본문은 보장되지 않는다.",
                                                              "content":  {
                                                                              "application/json":  {
                                                                                                       "schema":  {
                                                                                                                      "type":  "object",
                                                                                                                      "properties":  {

                                                                                                                                     }
                                                                                                                  }
                                                                                                   }
                                                                          }
                                                          },
                                         "Forbidden":  {
                                                           "description":  "TEACHER 권한이 아님. Security가 생성하므로 JSON 오류 본문은 보장되지 않는다.",
                                                           "content":  {
                                                                           "application/json":  {
                                                                                                    "schema":  {
                                                                                                                   "type":  "object",
                                                                                                                   "properties":  {

                                                                                                                                  }
                                                                                                               }
                                                                                                }
                                                                       }
                                                       },
                                         "DetectionConflict":  {
                                                                   "description":  "동일 분석일의 Snapshot 충돌 또는 허용되지 않는 실행 상태",
                                                                   "content":  {
                                                                                   "application/json":  {
                                                                                                            "schema":  {
                                                                                                                           "$ref":  "#/components/schemas/ErrorResponse"
                                                                                                                       }
                                                                                                        }
                                                                               }
                                                               },
                                         "NoLearningRecords":  {
                                                                   "description":  "분석할 활성 학생 또는 학습 근거가 없음",
                                                                   "content":  {
                                                                                   "application/json":  {
                                                                                                            "schema":  {
                                                                                                                           "$ref":  "#/components/schemas/ErrorResponse"
                                                                                                                       }
                                                                                                        }
                                                                               }
                                                               },
                                         "AiDetectionFailure":  {
                                                                    "description":  "AI 연동 또는 Detection 결과 처리 실패",
                                                                    "content":  {
                                                                                    "application/json":  {
                                                                                                             "schema":  {
                                                                                                                            "$ref":  "#/components/schemas/ErrorResponse"
                                                                                                                        }
                                                                                                         }
                                                                                }
                                                                },
                                         "DetectionRunNotFound":  {
                                                                      "description":  "없거나 다른 테넌트에 속한 Detection 실행",
                                                                      "content":  {
                                                                                      "application/json":  {
                                                                                                               "schema":  {
                                                                                                                              "$ref":  "#/components/schemas/ErrorResponse"
                                                                                                                          }
                                                                                                           }
                                                                                  }
                                                                  }
                                     }
                   },
    "x-checkon-communication":  {
                                    "caller":  "Frontend",
                                    "receiver":  "Backend",
                                    "scope":  "Detection",
                                    "serverUrl":  "http://localhost:8080/api/v1",
                                    "source":  "apidog_1.openapi.json"
                                }
}